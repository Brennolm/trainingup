# .gitignore of the `deploy` branch (generated by .github/workflows/deploy.yml).
# Hostinger's Git deployment preserves files matched by .gitignore rules, so server-only files
# survive each pull. Laravel's runtime folders (storage/*, bootstrap/cache) keep their own
# nested .gitignore files, which keep the folders but ignore their contents.

# Server configuration and Hostinger default page
/api/.env
/default.php
